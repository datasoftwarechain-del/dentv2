# ─── Supabase ────────────────────────────────────────────────────────────
# Las carga la integración de Supabase en Vercel. En local se copian del
# panel del proyecto (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: saltea la RLS. NUNCA en un archivo versionado ni en
# nada con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Solo en desarrollo: a dónde vuelve el enlace de confirmación de registro.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# ─── Sitio ───────────────────────────────────────────────────────────────
# URL pública, usada para armar los enlaces que van en los correos. Sin
# esto se cae al origen de la petición, que en un cron no existe.
NEXT_PUBLIC_SITE_URL=
# Número con código de país y sin signos (ej: 59899123456). Sin esto el
# botón de WhatsApp de soporte apunta a wa.me/ vacío.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Correo saliente (Resend) ────────────────────────────────────────────
# SIN ESTAS DOS NO SE MANDA NINGÚN CORREO. Las rutas responden 503 con un
# motivo legible en vez de romper, pero el diseñador nunca recibe el caso
# y el cliente nunca se entera de que su diseño está listo.
RESEND_API_KEY=
EMAIL_FROM=

# ─── Bot de reparto de diseños ───────────────────────────────────────────
# Secreto compartido del disparador. SIN ESTO LA RUTA RESPONDE 401 A TODO,
# incluido el cron de Vercel: el bot queda completamente inactivo.
BOT_WEBHOOK_SECRET=
# Vercel manda `Authorization: Bearer $CRON_SECRET` en sus cron. Tiene que
# valer LO MISMO que BOT_WEBHOOK_SECRET o el barrido diario no autentica.
CRON_SECRET=
# Interruptor de pánico: ponelo en "false" para apagar el bot sin desplegar.
BOT_DISPATCH_ENABLED=

# ─── Soporte ─────────────────────────────────────────────────────────────
# Email del administrador de soporte. Sin esto las tres rutas de
# /api/support/admin responden 403 (fallan cerrado, que está bien, pero la
# bandeja de soporte no se puede usar).
SUPPORT_ADMIN_EMAIL=

# ─── Organizaciones receptoras ───────────────────────────────────────────
# Opcionales: si no están, se resuelven solas — el laboratorio por nombre
# ("digital dent%") y el estudio por ser el único de tipo design_studio.
# Hacen falta recién cuando haya más de uno de cada tipo.
LAB_INTAKE_ORG_ID=
DESIGN_STUDIO_ORG_ID=

# ─── Pasarelas de pago (opcionales) ──────────────────────────────────────
# Un proveedor se ofrece solo si tiene credenciales; sin ninguna, el módulo
# de diseño funciona en modo factura manual.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ENV=
