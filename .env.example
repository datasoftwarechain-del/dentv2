# Supabase Configuration
# Obtener de: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ IMPORTANTE - SEGURIDAD:
# 1. Copiar este archivo a .env.local para desarrollo local
# 2. NUNCA commitear .env o .env.local a Git
# 3. Las claves actuales del proyecto están expuestas en el historial de Git
# 4. ROTAR INMEDIATAMENTE las claves de Supabase:
#    - Ir a Supabase Dashboard → Settings → API
#    - Click en "Reset project API keys"
#    - Copiar las nuevas claves a .env.local (NO a .env)
#    - Actualizar las variables de entorno en producción (Vercel/hosting)
# 5. En producción, usar variables de entorno del hosting, NO archivos .env
# 6. Verificar que .env está en .gitignore antes de commitear

# Instrucciones:
# $ cp .env.example .env.local
# $ # Editar .env.local con tus claves reales
# $ npm run dev

# ══════════════════════════════════════════════════════════════
# PASARELAS DE PAGO  (opcionales)
# ══════════════════════════════════════════════════════════════
# Sin ninguna configurada el sistema funciona igual: la orden queda en
# "esperando pago", el estudio factura por fuera y al registrar el pago
# en Facturación la orden entra a la cola sola.
#
# Cada pasarela se enciende sola cuando encuentra SUS variables. No hay
# que tocar código ni migrar nada.
#
# Stripe no figura acá a propósito: no opera en Uruguay, Argentina,
# Chile, Colombia ni Perú — en la región solo cubre Brasil y México.
# La capa lib/payments/ está preparada para agregarlo el día que se
# pueda, sin tocar el módulo de diseño.

# ─── PayPal — cobro internacional en dólares ───────────────────
# Developer Dashboard -> Apps & Credentials
# El WEBHOOK_ID sale de Webhooks, después de crear el endpoint
# apuntando a  https://TU-DOMINIO/api/webhooks/paypal
# Sin WEBHOOK_ID la ruta rechaza todo: no se puede validar la firma.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# 'live' cobra de verdad. Cualquier otro valor usa sandbox.
PAYPAL_ENV=sandbox

# ─── Mercado Pago — cobro en la región ─────────────────────────
# Tus integraciones -> Credenciales
# El SECRET sale de Webhooks, al crear el endpoint apuntando a
#   https://TU-DOMINIO/api/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# 'live' cobra de verdad. Cualquier otro valor usa sandbox.
MERCADOPAGO_ENV=sandbox
